# Copy to .env and fill in every value. NEVER commit .env to version control.
# .env is in .gitignore — keep it there.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite://data/support.db

# ─── Network ──────────────────────────────────────────────────────────────────
# Default is loopback (local dev). Change to 0.0.0.0:3000 for deployment behind
# a reverse proxy, or to a specific interface IP.
BIND_ADDR=127.0.0.1:3000

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 bytes (256 bits). Generate with:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_to_a_random_string_of_at_least_32_bytes

# Token lifetimes in seconds. Defaults: 900 (15 min) / 604800 (7 days).
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=604800

# ─── Desk account ─────────────────────────────────────────────────────────────
# Email for the built-in desk account. Change this from the default so the
# address isn't predictable from reading the open-source code.
# Default: desk@local — must be changed before any public deployment.
DESK_EMAIL=desk@local

# Password set on the desk account the FIRST time the server starts (seed).
# Only applies when no desk user exists yet — changing this after the first run
# has no effect. Default fallback: "changeme" (a warning is logged at startup).
# Generate a strong password before any deployment.
DESK_INITIAL_PASSWORD=CHANGE_ME_strong_password_for_desk_account

# Magic link URL lifetime in seconds (default: 86400 = 24 h).
# The link is single-use; this only limits how long an unclicked link stays valid.
# Reduce for tighter security (e.g. 3600 = 1 h) in high-risk deployments.
MAGIC_LINK_TTL_SECS=86400

# ─── Cookies ──────────────────────────────────────────────────────────────────
# Set to false only for plain-HTTP local development. Must be true (the default)
# in any HTTPS deployment — the Secure flag prevents cookie transmission over HTTP.
COOKIE_SECURE=true

# ─── Encryption ───────────────────────────────────────────────────────────────
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  ⚠  CRITICAL WARNING — READ BEFORE DEPLOYING                           │
# │                                                                          │
# │  ENCRYPTION_PASSPHRASE and ENCRYPTION_SALT are the ONLY means to        │
# │  decrypt stored thread message bodies. If either value is lost or        │
# │  changed after the first run, every thread entry in the database         │
# │  becomes permanently unrecoverable. There is no recovery path.           │
# │                                                                          │
# │  • Back up this .env file securely and SEPARATELY from the database.    │
# │  • Never commit .env to version control (it is in .gitignore).          │
# │  • Never change ENCRYPTION_SALT after the first run.                    │
# └──────────────────────────────────────────────────────────────────────────┘
#
# ENCRYPTION_PASSPHRASE — choose a strong, unique passphrase (min 16 chars).
ENCRYPTION_PASSPHRASE=CHANGE_ME_to_a_strong_unique_passphrase

# ENCRYPTION_SALT — generate ONCE with: openssl rand -hex 32
# Requirements: cryptographically random, minimum 32 hex characters (16 bytes),
# unique per deployment, and NEVER changed after the first run.
# Changing it after data exists renders all encrypted thread entries permanently unreadable.
ENCRYPTION_SALT=CHANGE_ME_run_openssl_rand_hex_32_to_generate

# ─── Email hash salt ──────────────────────────────────────────────────────────
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  ⚠  CRITICAL WARNING — READ BEFORE DEPLOYING                           │
# │                                                                          │
# │  EMAIL_HASH_SALT is used to build a blind index for email lookups.      │
# │  If this value is lost or changed after the first run, all existing      │
# │  login attempts will fail — users will not be found by email.           │
# │                                                                          │
# │  Generate ONCE with: openssl rand -hex 32                               │
# │  Never change after the first run. Back up alongside ENCRYPTION_SALT.  │
# └──────────────────────────────────────────────────────────────────────────┘
EMAIL_HASH_SALT=CHANGE_ME_run_openssl_rand_hex_32_to_generate

# ─── Public base URL ──────────────────────────────────────────────────────────
# Used when building magic-link URLs sent to clients. No trailing slash.
# Must be https:// in production (enforced at startup when COOKIE_SECURE=true).
# Example production value: https://support.example.com
# For local dev with HTTP: set COOKIE_SECURE=false and use http://localhost:5173
BASE_URL=https://support.example.com

# ─── Token lifetimes ──────────────────────────────────────────────────────────
# Scoped tokens are single-use JWTs for client portal access. Default: 86400 (24 h).
SCOPED_TOKEN_TTL_SECS=86400

# ─── SMTP / email ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST unset (or commented out) to disable email sending entirely.
# Emails are always fire-and-forget — a delivery failure never blocks the request.
#
# Production example (STARTTLS, port 587):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=support@example.com
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM=support@example.com
# SMTP_TLS: "starttls" (default, production) | "none" (local dev only, plaintext)
SMTP_TLS=starttls
#
# Local dev example using Mailpit (https://mailpit.axllent.org — run: mailpit):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_TLS=none
# SMTP_USER=   (leave blank — Mailpit requires no credentials)
# SMTP_PASSWORD=
# SMTP_FROM=support@localhost

# ─── Rate limiting ─────────────────────────────────────────────────────────────
# Auth endpoints (login, refresh, magic exchange): requests per second per IP.
# Burst allows short spikes above the sustained rate.
# Default: 5 req/s, burst 10. Lower in production if under brute-force pressure.
RATE_LIMIT_AUTH_RPS=5
RATE_LIMIT_AUTH_BURST=10

# Report endpoint (PDF generation — CPU-intensive): requests per second per IP.
# Fractional values OK (e.g. 0.2 = one request every 5 seconds). Default: 0.2, burst 3.
RATE_LIMIT_REPORT_RPS=0.2
RATE_LIMIT_REPORT_BURST=3
