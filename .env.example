# Copy to .env and fill in every value. NEVER commit .env to version control.
# .env is in .gitignore — keep it there.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite://data/support.db

# ─── Network ──────────────────────────────────────────────────────────────────
# Default is loopback (local dev). Change to 0.0.0.0:3000 for deployment behind
# a reverse proxy, or to a specific interface IP.
BIND_ADDR=127.0.0.1:3000

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 bytes (256 bits). Generate with:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_to_a_random_string_of_at_least_32_bytes

# Token lifetimes in seconds. Defaults: 900 (15 min) / 604800 (7 days).
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=604800

# ─── Cookies ──────────────────────────────────────────────────────────────────
# Set to false only for plain-HTTP local development. Must be true (the default)
# in any HTTPS deployment — the Secure flag prevents cookie transmission over HTTP.
COOKIE_SECURE=true

# ─── Encryption ───────────────────────────────────────────────────────────────
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  ⚠  CRITICAL WARNING — READ BEFORE DEPLOYING                           │
# │                                                                          │
# │  ENCRYPTION_PASSPHRASE and ENCRYPTION_SALT are the ONLY means to        │
# │  decrypt stored thread message bodies. If either value is lost or        │
# │  changed after the first run, every thread entry in the database         │
# │  becomes permanently unrecoverable. There is no recovery path.           │
# │                                                                          │
# │  • Back up this .env file securely and SEPARATELY from the database.    │
# │  • Never commit .env to version control (it is in .gitignore).          │
# │  • Never change ENCRYPTION_SALT after the first run.                    │
# └──────────────────────────────────────────────────────────────────────────┘
#
# ENCRYPTION_PASSPHRASE — choose a strong, unique passphrase (min 16 chars).
ENCRYPTION_PASSPHRASE=CHANGE_ME_to_a_strong_unique_passphrase

# ENCRYPTION_SALT — generate ONCE with: openssl rand -hex 32
# Requirements: cryptographically random, minimum 32 hex characters (16 bytes),
# unique per deployment, and NEVER changed after the first run.
# Changing it after data exists renders all encrypted thread entries permanently unreadable.
ENCRYPTION_SALT=CHANGE_ME_run_openssl_rand_hex_32_to_generate
